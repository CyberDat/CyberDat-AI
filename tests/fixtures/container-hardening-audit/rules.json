{
  "_note": "Finding ids frozen on 2026-11-18 BEFORE any audit code. Own rules written by CyberDat; not derived from, numbered like or paraphrasing any CIS Benchmark. Severity: high, medium, low, info (info = hygiene, grouped). Input errors are not findings.",
  "dockerfile": [
    {
      "id": "DF-USER-001",
      "severity": "high",
      "meaning": "final stage has no USER instruction (runs as root)"
    },
    {
      "id": "DF-USER-002",
      "severity": "high",
      "meaning": "last USER of the final stage is root or UID 0"
    },
    {
      "id": "DF-TAG-001",
      "severity": "medium",
      "meaning": "FROM image uses the latest tag"
    },
    {
      "id": "DF-TAG-002",
      "severity": "medium",
      "meaning": "FROM image has neither tag nor digest (scratch, earlier stages and ${VAR} images excluded)"
    },
    {
      "id": "DF-SEC-001",
      "severity": "high",
      "meaning": "secret value in ENV or ARG (by name with a literal value, or a recognised secret pattern); masked"
    },
    {
      "id": "DF-ADD-001",
      "severity": "medium",
      "meaning": "ADD with a remote URL"
    },
    {
      "id": "DF-PIPE-001",
      "severity": "high",
      "meaning": "RUN downloads with curl or wget and pipes into a shell or interpreter"
    },
    {
      "id": "DF-PORT-001",
      "severity": "medium",
      "meaning": "EXPOSE of a remote-administration or daemon port (22, 23, 2375, 2376, 3389, 5900)"
    },
    {
      "id": "DF-SUDO-001",
      "severity": "low",
      "meaning": "sudo used in RUN"
    },
    {
      "id": "DF-HYG-001",
      "severity": "info",
      "meaning": "ADD of a local file; COPY is clearer"
    },
    {
      "id": "DF-HYG-002",
      "severity": "info",
      "meaning": "no HEALTHCHECK in the final stage"
    },
    {
      "id": "DF-HYG-003",
      "severity": "info",
      "meaning": "apt-get install without --no-install-recommends"
    }
  ],
