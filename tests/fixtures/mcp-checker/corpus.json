    { "id": "rk-name-similar-tool", "expect": { "group": "names", "rule": "MCP-NAME-002", "min": "low" }, "config": { "mcpServers": { "mail": { "url": "https://mail.example.com/mcp", "tools": [ { "name": "send_email", "description": "Send an email", "inputSchema": { "type": "object", "properties": {} } } ] }, "extras": { "url": "https://extras.example.net/mcp", "tools": [ { "name": "send_emails", "description": "Send emails", "inputSchema": { "type": "object", "properties": {} } } ] } } } },
    { "id": "rk-name-typosquat", "expect": { "group": "names", "rule": "MCP-NAME-004", "min": "medium" }, "config": { "mcpServers": { "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesytem", "/Users/alice/projects"] } } } },
    { "id": "rk-name-scope", "expect": { "group": "names", "rule": "MCP-NAME-004", "min": "medium" }, "config": { "mcpServers": { "memory": { "command": "npx", "args": ["-y", "@modelcontext-protocol/server-memory"] } } } },
    { "id": "rk-name-dupkey", "expect": { "group": "names", "rule": "MCP-NAME-003", "min": "medium" }, "text": "{\"mcpServers\":{\"git\":{\"command\":\"uvx\",\"args\":[\"mcp-server-git\"]},\"git\":{\"command\":\"npx\",\"args\":[\"-y\",\"example-git-mcp\"]}}}" },

    { "id": "rk-hyg-docker-latest", "expect": { "group": "hygiene", "rule": "MCP-HYG-001", "min": "low" }, "config": { "mcpServers": { "tools": { "command": "docker", "args": ["run", "-i", "--rm", "registry.example.com/mcp/tools:latest"] } } } },
    { "id": "rk-hyg-autoapprove-star", "expect": { "group": "hygiene", "rule": "MCP-HYG-004", "min": "high" }, "config": { "mcpServers": { "shell": { "command": "npx", "args": ["-y", "example-shell-mcp@1.0.0"], "autoApprove": ["*"], "tools": [ { "name": "execute_command", "description": "Execute a command", "inputSchema": { "type": "object", "properties": { "command": { "type": "string" } } } } ] } } } },
    { "id": "rk-hyg-fs-no-dirs", "expect": { "group": "hygiene", "rule": "MCP-HYG-002", "min": "low" }, "config": { "mcpServers": { "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem"] } } } },
    { "id": "rk-hyg-trust", "expect": { "group": "hygiene", "rule": "MCP-HYG-004", "min": "medium" }, "config": { "mcpServers": { "ops": { "command": "node", "args": ["/opt/ops-mcp/index.js"], "trust": true } } } }
