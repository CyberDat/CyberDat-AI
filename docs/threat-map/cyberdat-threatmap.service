# Sample unit: Global Cyber Threat Map collector (staging). Installed by Codex; adjust the paths to the server.
# Runs as the site user (never root). `wp cyberdat threatmap sync` runs only the layers that are due:
# feodo in the :07 slot, ransomware in the :27 slot, radar (Cloudflare Radar) in the :47 slot; a missed slot is
# caught up by any later run two hours after the layer's previous attempt.
# Each source's MIN_INTERVAL is enforced in the code. No WP-Cron.
[Unit]
Description=CyberDat staging Global Cyber Threat Map sync
After=network-online.target mariadb.service
Wants=network-online.target
ConditionPathExists=/var/www/cyberdat-staging/public/wp-config.php

[Service]
Type=oneshot
User=cyberdat-staging
Group=cyberdat-staging
WorkingDirectory=/var/www/cyberdat-staging/public
Environment=WP_CLI_CACHE_DIR=/tmp/wp-cli-cache
ExecStart=/usr/local/bin/wp --path=/var/www/cyberdat-staging/public cyberdat threatmap sync
# Normally one layer per run; at most three layers with three requests of 20 s each, plus the database work.
TimeoutStartSec=600
MemoryMax=256M
CPUQuota=25%
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
